{
  // Example OpenClaw config for running Maximus.
  // Copy to ~/.openclaw/openclaw.json (or merge into your existing one) and edit.
  // JSON5: comments and trailing commas are allowed.
  // Schema checked against docs.openclaw.ai on 2026-09-30. If OpenClaw has
  // changed since, trust `openclaw onboard` over this file.

  "agents": {
    "defaults": {
      "model": {
        // ── Pick ONE primary ─────────────────────────────────────────────

        // PATH A — Local model, zero keys, free-free.
        // READ skills/maximus-openclaw-local FIRST. Maximus injects roughly
        // 8,000 tokens per run before OpenClaw's own prompt, and Ollama's
        // default context on machines under ~23 GiB VRAM is 4,096. Unless you
        // raise it, the prompt is silently truncated.
        // Build a tag with the context baked in (Ollama's OpenAI-compatible
        // API cannot set context per request):
        //   printf 'FROM qwen3:8b\nPARAMETER num_ctx 65536\n' > Modelfile
        //   ollama create qwen3-64k -f Modelfile
        // Or server-wide: OLLAMA_CONTEXT_LENGTH=65536 ollama serve
        // Ollama's OpenClaw guide recommends at least 64K for local models.
        "primary": "ollama/qwen3-64k",

        // PATH B — Bring your own model (frontier quality, your API cost).
        // Replace the primary above with one of these, and provide the matching
        // key via the host's secret store or env (never inline here).
        // "primary": "anthropic/claude-sonnet-4-6",
        // "primary": "openai/gpt-5",

        // HYBRID — local primary, cloud fallback when local fails or times out.
        // "fallbacks": ["anthropic/claude-sonnet-4-6"]
      }
    }
  },

  // Uncomment to declare a local OpenAI-compatible server (llama.cpp,
  // LM Studio, MLX) explicitly. contextWindow MUST match what the server
  // actually runs, or OpenClaw budgets for context that isn't there.
  // "models": {
  //   "mode": "merge",
  //   "providers": {
  //     "local": {
  //       "baseUrl": "http://127.0.0.1:8080/v1",
  //       "api": "openai-completions",
  //       "timeoutSeconds": 300,
  //       "models": [{ "id": "my-model", "name": "Local", "contextWindow": 65536, "maxTokens": 8192 }]
  //     }
  //   }
  // },

  "skills": {
    "load": {
      // Watch skill folders so edits hot-reload on the next turn.
      "watch": true
    }
    // On a small box, cap the injected skill list:
    // "limits": { "maxSkillsPromptChars": 12000 }
  },

  // Workspace files (SOUL.md, AGENTS.md, TOOLS.md) and skills/ are picked up
  // from the workspace root that install.sh links into ~/.openclaw/workspace.

  "_notes": [
    "Maximus's layer is free. The model is yours — local (free, your hardware) or API (your cost).",
    "Verify a local setup: `ollama ps` must show your context size, and the agent must be able to quote the first heading of SOUL.md.",
    "For a personal single-user assistant, keep DM access paired/local. Do not expose the gateway or Ollama (OLLAMA_HOST=0.0.0.0) publicly without auth in front.",
    "Memory starts as flat files in memory/. Switch to memory-lancedb or memory-wiki only when the store outgrows context."
  ]
}
