{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.config/gcloud", "~/.openclaw", "**/.env", "**/.env.*"],
      "denyWrite": [".git/hooks", ".mcp.json", ".claude/commands", ".claude/agents", ".vscode", "~/.bashrc", "~/.zshrc", "~/.profile"]
    },
    "network": {
      "allowedDomains": ["registry.npmjs.org", "pypi.org", "files.pythonhosted.org", "github.com"]
    },
    "excludedCommands": []
  }
}
